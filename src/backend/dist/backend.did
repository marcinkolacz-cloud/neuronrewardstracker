type WtnStats = 
 record {
   percentReturn: float64;
   positionId: WtnPositionId;
   redeemableIcpValue: float64;
   totalCapitalContributed: float64;
   totalEarned: float64;
   totalWithdrawn: float64;
 };
type WtnSnapshot = 
 record {
   date: Timestamp;
   eventType: WtnEventType;
   nicpHeld: float64;
   positionId: WtnPositionId;
   redeemableIcpValue: float64;
   totalIcpPaid: float64;
 };
type WtnPositionId = nat;
type WtnPosition = 
 record {
   id: WtnPositionId;
   name: text;
   ownerId: principal;
   startDate: Timestamp;
 };
type WtnHistoricalEntry = 
 record {
   date: Timestamp;
   nicpHeld: float64;
   redeemableIcpValue: float64;
   totalIcpPaid: float64;
 };
type WtnEventType = 
 variant {
   capitalAdded;
   firstReading;
   organicGrowth;
   withdrawal;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type TransformationOutput = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: HttpRequestResult;
 };
type Timestamp = int;
type TimerId = nat;
type SyncStatus = 
 variant {
   failed;
   hotkeyRequired;
   neverSynced;
   synced;
 };
type SyncResult = 
 record {
   lastSyncError: opt text;
   maturityE8s: opt nat64;
   neuronId: NeuronId;
   stakedE8s: opt nat64;
   status: SyncStatus;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type PriceSnapshot = 
 record {
   cached: bool;
   pln: float64;
   timestamp: int;
   unavailable: bool;
   usd: float64;
 };
type PortfolioStats = 
 record {
   blendedApy: float64;
   combinedRewardsThisMonthE8s: nat64;
   neuronCount: nat;
   nnsCapitalContributedE8s: E8s;
   nnsRewardsE8s: int;
   nnsRewardsThisMonthE8s: nat64;
   nnsStakedE8s: E8s;
   percentageReturn: float64;
   totalCapitalContributedE8s: E8s;
   totalDisbursedE8s: int;
   totalMaturityE8s: nat64;
   totalPortfolioValueE8s: int;
   totalRewardsE8s: int;
   totalRewardsThisMonthE8s: nat64;
   totalStakedE8s: E8s;
   wtnCapitalContributedE8s: E8s;
   wtnRewardsE8s: int;
   wtnRewardsThisMonthFloat: float64;
   wtnStakedE8s: E8s;
 };
type PortfolioRewardStats = 
 record {
   apy30d: float64;
   averageDailyRewardE8s: int;
   monthly: vec MonthlyBreakdown;
   monthlyReadings: nat;
   overallReturnPct: float64;
   totalCapitalContributedE8s: E8s;
   totalRewardsE8s: int;
 };
type NeuronStats = 
 record {
   apy30d: float64;
   averageDailyRewardE8s: int;
   currentMaturityE8s: int;
   monthly: vec MonthlyBreakdown;
   neuronId: NeuronId;
   overallReturnPct: float64;
   percentageReturn: float64;
   totalCapitalContributedE8s: E8s;
   totalDisbursedE8s: int;
   totalRewardsE8s: int;
 };
type NeuronId = nat64;
type Neuron = 
 record {
   dissolveDelaySeconds: nat64;
   id: NeuronId;
   initialStakeE8s: E8s;
   name: text;
   ownerId: principal;
   stakedE8s: E8s;
   startDate: Timestamp;
 };
type MonthlyBreakdown = 
 record {
   momDeltaE8s: int;
   month: nat;
   readingCount: nat;
   totalDeltaE8s: int;
   year: nat;
 };
type InviteCodeStatus = 
 variant {
   revoked;
   unused;
   used;
 };
type InviteCode = 
 record {
   code: text;
   createdAt: Timestamp;
   status: InviteCodeStatus;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type HistoricalEntry = 
 record {
   stakedMaturityE8s: E8s;
   timestamp: Timestamp;
   unstakedMaturityE8s: E8s;
 };
type EventType = 
 variant {
   disburseOrSpawn;
   externalTopUp;
   firstReading;
   mergedToStake;
   normalGrowth;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type E8s = nat64;
type DeltaE8s = int;
type DailyReward = 
 record {
   autoStakeMaturity: bool;
   deltaE8s: DeltaE8s;
   eventType: EventType;
   neuronId: NeuronId;
   stakeDeltaE8s: E8s;
   stakedMaturityE8s: E8s;
   timestamp: Timestamp;
   unstakedMaturityE8s: E8s;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  ___dailySyncInstalled: () -> (bool) query;
  __accessControlState: () -> (reserved) query;
  __adminPrincipal: () -> (reserved) query;
  __grantedPrincipals: (ko: opt principal, count: opt nat) ->
   (vec principal) query;
  __inviteCodes: () -> (reserved) query;
  __neurons: () -> (reserved) query;
  __nextWtnPositionId: () -> (reserved) query;
  __priceCache: () -> (reserved) query;
  __rewards: () -> (reserved) query;
  __syncErrors: () -> (reserved) query;
  __syncStatuses: () -> (reserved) query;
  __wtnPositions: (ko: opt WtnPositionId, count: opt nat) ->
   (vec record {
          WtnPositionId;
          WtnPosition;
        }) query;
  __wtnSnapshots: () -> (reserved) query;
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  addNeuron: (id: NeuronId, name: text, startDate: int, dissolveDelaySeconds:
   nat64, initialStakeE8s: nat64) -> ();
  addWtnPosition: (name: text, startDate: int) -> (WtnPosition);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  checkAccess: (code: text) -> (bool);
  deleteSnapshot: (neuronId: NeuronId, timestamp: int) -> ();
  deleteWtnSnapshot: (positionId: WtnPositionId, date: int) -> ();
  editSnapshot: (neuronId: NeuronId, timestamp: int, newTimestamp: int,
   newMaturityE8s: nat64) -> ();
  editWtnSnapshot: (positionId: WtnPositionId, date: int, newDate: int,
   newNicpHeld: float64, newTotalIcpPaid: float64, newRedeemableIcpValue:
   float64) -> ();
  execute: (qJson: text) -> (Result) query;
  generateInviteCode: () -> (text);
  getCallerUserRole: () -> (UserRole) query;
  getCurrentIcpPrice: () -> (PriceSnapshot);
  getHistoricalIcpPrice: (date: text) -> (PriceSnapshot);
  getNeuronStats: (neuronId: NeuronId) -> (NeuronStats);
  getPortfolioRewardStats: () -> (PortfolioRewardStats);
  getPortfolioStats: () -> (PortfolioStats);
  getRewardHistory: (neuronId: NeuronId) -> (vec DailyReward);
  getSyncError: (neuronId: NeuronId) -> (opt text);
  getSyncStatus: (neuronId: NeuronId) -> (SyncStatus);
  getWtnPosition: (positionId: WtnPositionId) -> (opt WtnPosition);
  getWtnSnapshots: (positionId: WtnPositionId) -> (vec WtnSnapshot);
  getWtnStats: (positionId: WtnPositionId) -> (WtnStats);
  importHistoricalData: (neuronId: NeuronId, entries: vec HistoricalEntry) ->
   ();
  importWtnHistoricalData: (positionId: WtnPositionId, entries:
   vec WtnHistoricalEntry) -> ();
  isAdminBootstrapped: () -> (bool) query;
  isCallerAdmin: () -> (bool) query;
  isCallerAdminPrincipal: () -> (bool) query;
  isCallerGranted: () -> (bool) query;
  isPrincipalGranted: ("principal": principal) -> (bool) query;
  listInviteCodes: () -> (vec InviteCode);
  listMyNeurons: () -> (vec Neuron);
  listMyWtnPositions: () -> (vec WtnPosition);
  recordSnapshot: (neuronId: NeuronId, unstakedMaturityE8s: nat64,
   stakedMaturityE8s: nat64, autoStakeMaturity: bool) -> (DailyReward);
  recordWtnSnapshot: (positionId: WtnPositionId, date: int, nicpHeld:
   float64, totalIcpPaid: float64, redeemableIcpValue: float64) ->
   (WtnSnapshot);
  removeNeuron: (neuronId: NeuronId) -> ();
  removeWtnPosition: (positionId: WtnPositionId) -> ();
  revokeInviteCode: (code: text) -> ();
  /// Schedule the next daily sync at 18:01 Europe/Warsaw. Recomputes the
  /// target on every call so DST transitions do not cause drift. After the
  /// sync runs, reschedules for the following 18:01 Warsaw.
  /// 
  /// `Timer.setTimer<system>` requires the `<system>` capability, which is
  /// available in `shared` functions and async callbacks but NOT in a plain
  /// actor `func` or a transient-let initializer. This function is therefore
  /// only ever called from two system-capable contexts: (1) the
  /// `public shared func startDailySync()` below, and (2) the async timer
  /// callback passed to `Timer.setTimer` (which itself has the system
  /// capability, so rescheduling works). It must NOT be called from a plain
  /// transient let or a non-shared private func.
  scheduleNextSync: () -> (TimerId);
  schema: () -> (text) query;
  setAdminPrincipal: () -> ();
  /// Install the daily sync timer on first call. Public shared functions run
  /// in an async context that has the `<system>` capability, so
  /// `scheduleNextSync()` (which calls `Timer.setTimer<system>`) is valid
  /// here. Idempotent: subsequent calls are no-ops once the timer is running
  /// (the timer reschedules itself from its own async callback, which also
  /// has the system capability).
  startDailySync: () -> ();
  syncAllMyNeurons: () -> (vec SyncResult);
  syncNeuron: (neuronId: NeuronId) -> (SyncResult);
  /// IC HTTP outcall transform callback. Required by the IC HTTP outcall
  /// protocol: it must be a public `query` function on the actor and strips
  /// response headers so the response body is the only thing that survives
  /// into consensus. Passed to PricesLib functions and the PricesApi mixin.
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  updateNeuron: (neuron: Neuron) -> ();
  updateWtnPosition: (position: WtnPosition) -> ();
}
